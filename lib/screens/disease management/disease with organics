  Future<void> _initializeNotifications() async {
    const androidInitSettings = AndroidInitializationSettings('@mipmap/ic_launcher');
    const initializationSettings = InitializationSettings(android: androidInitSettings);
    await _notificationsPlugin.initialize(initializationSettings);
  }

  void _updateDiseaseDetails() {
    if (_selectedCrop != null && _selectedStage != null && _selectedDisease != null) {
      String diseaseKey = '${_selectedCrop}_${_selectedStage}_$_selectedDisease';
      if (_diseaseDetails.containsKey(diseaseKey)) {
        setState(() {
          _diseaseData = DiseaseData.fromMap({
            'name': _selectedDisease,
            'imagePath': _diseaseDetails[diseaseKey]!['imagePath'],
            'possibleCauses': _diseaseDetails[diseaseKey]!['possibleCauses'],
            'preventionStrategies': _diseaseDetails[diseaseKey]!['preventionStrategies'],
            'activeAgent': _diseaseDetails[diseaseKey]!['activeAgent'],
            'fungicides': _diseaseDetails[diseaseKey]!['fungicides'],
          });
          _showDiseaseDetails = true;
          _imageKey = UniqueKey();
        });
        Timer(const Duration(milliseconds: 100), () {
          if (mounted && _hintsKey.currentContext != null) {
            Scrollable.ensureVisible(
              _hintsKey.currentContext!,
              duration: const Duration(milliseconds: 300),
              curve: Curves.easeInOut,
            );
          }
        });
      } else {
        setState(() {
          _showDiseaseDetails = false;
          _diseaseData = null;
          _imageKey = UniqueKey();
        });
      }
    } else {
      setState(() {
        _showDiseaseDetails = false;
        _diseaseData = null;
        _imageKey = UniqueKey();
      });
    }
  }

