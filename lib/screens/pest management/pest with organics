  @override
  void initState() {
    super.initState();
    _initializeNotifications();
  }

  Future<void> _initializeNotifications() async {
    const androidInitSettings = AndroidInitializationSettings('@mipmap/ic_launcher');
    const initializationSettings = InitializationSettings(android: androidInitSettings);
    await _notificationsPlugin.initialize(initializationSettings);
  }

  void _updatePestDetails() {
    if (_selectedCrop != null && _selectedStage != null && _selectedPest != null) {
      String pestKey = '${_selectedCrop}_${_selectedStage}_$_selectedPest';
      if (_pestDetails.containsKey(pestKey)) {
        setState(() {
          _pestData = PestData(
            name: _selectedPest!,
            imagePath: _pestDetails[pestKey]!['imagePath'] as String,
            preventionStrategies: List<String>.from(_pestDetails[pestKey]!['preventionStrategies'] ?? []),
            activeAgent: _pestDetails[pestKey]!['activeAgent'] as String,
            possibleCauses: List<String>.from(_pestDetails[pestKey]!['possibleCauses'] ?? []),
            herbicides: List<String>.from(_pestDetails[pestKey]!['herbicides'] ?? []),
          );
          _showPestDetails = true;
          _imageKey = UniqueKey();
        });
        Timer(const Duration(milliseconds: 100), () {
          if (mounted && _hintsKey.currentContext != null) {
            Scrollable.ensureVisible(
              _hintsKey.currentContext!,
              duration: const Duration(milliseconds: 300),
              curve: Curves.easeInOut,
            );
          }
        });
      } else {
        setState(() {
          _showPestDetails = false;
          _pestData = null;
          _imageKey = UniqueKey();
        });
      }
    } else {
      setState(() {
        _showPestDetails = false;
        _pestData = null;
        _imageKey = UniqueKey();
      });
    }
  }

  void _showOrganicPestGuide() {
    showDialog(
      context: context,
      builder: (context) => AlertDialog(
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
        title: const Text('Organic Pest Management Guide'),
        content: SingleChildScrollView(
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            mainAxisSize: MainAxisSize.min,
            children: [
              const Text(
                'Organic farmers can manage pests using biological methods. Here are some tips:',
                style: TextStyle(fontWeight: FontWeight.bold),
              ),
              const SizedBox(height: 8),
              ..._organicPreventionStrategies.map((strategy) => Text('• $strategy')),
              const Text('• Use organic pesticides like:'),
              ..._organicPesticides.map((pesticide) => Text('• $pesticide')),
            ],
          ),
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context),
            child: const Text('OK'),
          ),
        ],
      ),
    );
  }

