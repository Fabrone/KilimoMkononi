  @override
  void initState() {
    super.initState();
    _initializeNotifications();
  }

  @override
  void dispose() {
    _scrollController.dispose();
    super.dispose();
  }

  Future<void> _initializeNotifications() async {
    const androidSettings = AndroidInitializationSettings('@mipmap/ic_launcher');
    const initSettings = InitializationSettings(android: androidSettings);
    await _notificationsPlugin.initialize(initSettings);
    await _notificationsPlugin
        .resolvePlatformSpecificImplementation<AndroidFlutterLocalNotificationsPlugin>()
        ?.requestNotificationsPermission();
  }

  void _updatePestDetails() {
    if (_selectedPest != null && _selectedCrop != null && _selectedStage != null) {
      // Create a unique key using crop, stage, and pest name
      String pestKey = '${_selectedCrop}_${_selectedStage}_$_selectedPest';
      
      // Clear previous image by generating new key
      _imageKey = UniqueKey();
      
      // Check if the pest exists for this specific crop and stage
      if (_pestDetails.containsKey(pestKey)) {
        final pestInfo = _pestDetails[pestKey]!;
        setState(() {
          _pestData = PestData(
            name: _selectedPest!,
            imagePath: pestInfo['imagePath'],
            preventionStrategies: pestInfo['possibleStrategies'],
            activeAgent: pestInfo['intervention'].contains('(') 
                ? pestInfo['intervention'].split('(')[1].replaceAll(')', '')
                : 'No chemical control',
            possibleCauses: pestInfo['possibleCauses'],
            herbicides: pestInfo['herbicidesPesticides'],
          );
        });
      } else {
        // Fallback: try without stage if stage-specific key doesn't exist
        String fallbackKey = '${_selectedCrop}_$_selectedPest';
        if (_pestDetails.containsKey(fallbackKey)) {
          final pestInfo = _pestDetails[fallbackKey]!;
          setState(() {
            _pestData = PestData(
              name: _selectedPest!,
              imagePath: pestInfo['imagePath'],
              preventionStrategies: pestInfo['possibleStrategies'],
              activeAgent: pestInfo['intervention'].contains('(') 
                  ? pestInfo['intervention'].split('(')[1].replaceAll(')', '')
                  : 'No chemical control',
              possibleCauses: pestInfo['possibleCauses'],
              herbicides: pestInfo['herbicidesPesticides'],
            );
          });
        } else {
          // Show error message if pest not found
          ScaffoldMessenger.of(context).showSnackBar(
            SnackBar(
              content: Text('Pest data not found for $_selectedPest in $_selectedCrop at $_selectedStage stage'),
              backgroundColor: Colors.red,
            ),
          );
        }
      }
    }
  }

  void _scrollToHints() {
    if (_showPestDetails && _hintsKey.currentContext != null) {
      final RenderBox box = _hintsKey.currentContext!.findRenderObject() as RenderBox;
      final position = box.localToGlobal(Offset.zero).dy + _scrollController.offset - 100;
      _scrollController.animateTo(
        position,
        duration: const Duration(milliseconds: 300),
        curve: Curves.easeInOut,
      );
    }
  }

