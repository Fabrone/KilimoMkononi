  // Store selected symptoms
  Map<String, List<bool>> selectedSymptoms = {};
  bool _isLoading = false;

  @override
  void initState() {
    super.initState();
    _updateSymptomsForCrop();
  }

  void _updateSymptomsForCrop() {
    final symptomsForCrop = cropSymptoms[selectedCrop] ?? cropSymptoms['Other']!;
    selectedSymptoms = {};
    symptomsForCrop.forEach((section, categories) {
      int totalSymptoms = categories['Pests']!.length + categories['Diseases']!.length;
      selectedSymptoms[section] = List.filled(totalSymptoms, false);
    });
  }

  void _analyzeSymptoms() async {
    setState(() => _isLoading = true);
    await Future.delayed(const Duration(seconds: 2));

    List<String> allSelectedSymptoms = [];
    final symptomsForCrop = cropSymptoms[selectedCrop] ?? cropSymptoms['Other']!;
    symptomsForCrop.forEach((section, categories) {
      List<String> allSymptoms = [...categories['Pests']!, ...categories['Diseases']!];
      for (int i = 0; i < allSymptoms.length; i++) {
        if (selectedSymptoms[section]![i]) {
          allSelectedSymptoms.add(allSymptoms[i]);
        }
      }
    });

    if (allSelectedSymptoms.isEmpty) {
      _showResult('Please select at least one symptom to analyze.', const SizedBox.shrink());
      setState(() => _isLoading = false);
      return;
    }

    String resultMessage;
    Widget navigationButton;

    // Thorough matching for crop-specific pests/diseases
    final pestsDiseases = cropPestsDiseases[selectedCrop] ?? [];
    if (pestsDiseases.isEmpty) {
      // Fallback for 'Other' crop
      _fallbackAnalyze(allSelectedSymptoms);
      return;
    }

    // Calculate match scores
    List<Map<String, dynamic>> matches = pestsDiseases.map((pd) {
      final overlap = pd['symptoms'].toSet().intersection(allSelectedSymptoms.toSet()).length;
      final score = pd['symptoms'].isEmpty ? 0 : (overlap / pd['symptoms'].length) * 100;
      return {'name': pd['name'], 'type': pd['type'], 'score': score};
    }).toList();

    matches.sort((a, b) => b['score'].compareTo(a['score']));
    final topMatches = matches.where((m) => m['score'] > 30).toList(); // Lowered threshold for better matching

    int pestCount = topMatches.where((m) => m['type'] == 'Pest').length;
    int diseaseCount = topMatches.where((m) => m['type'] == 'Disease').length;

    String likelyCauses = topMatches.isEmpty
        ? (matches.isNotEmpty ? matches.first['name'] : 'unknown')
        : topMatches.map((m) => '${m['name']} (${m['score'].toStringAsFixed(0)}% match)').join(', ');

    if (pestCount > diseaseCount && pestCount > 0) {
      resultMessage = 'Likely pest-affected (e.g., $likelyCauses).';
      navigationButton = ElevatedButton(
        onPressed: () => Navigator.push(
          context,
          MaterialPageRoute(builder: (context) => const PestManagementPage()),
        ),
        style: ElevatedButton.styleFrom(
          backgroundColor: const Color.fromARGB(255, 3, 39, 4),
          foregroundColor: Colors.white,
        ),
        child: const Text('Manage Pest'),
      );
    } else if (diseaseCount > pestCount && diseaseCount > 0) {
      resultMessage = 'Likely disease-affected (e.g., $likelyCauses).';
      navigationButton = ElevatedButton(
        onPressed: () => Navigator.push(
          context,
          MaterialPageRoute(builder: (context) => const DiseaseManagementPage()),
        ),
        style: ElevatedButton.styleFrom(
          backgroundColor: const Color.fromARGB(255, 3, 39, 4),
          foregroundColor: Colors.white,
        ),
        child: const Text('Manage Disease'),
      );
    } else {
      resultMessage = 'Could be pest or disease (e.g., $likelyCauses).';
      navigationButton = Row(
        mainAxisAlignment: MainAxisAlignment.center,
        children: [
          ElevatedButton(
            onPressed: () => Navigator.push(
              context,
              MaterialPageRoute(builder: (context) => const PestManagementPage()),
            ),
            style: ElevatedButton.styleFrom(
              backgroundColor: const Color.fromARGB(255, 3, 39, 4),
              foregroundColor: Colors.white,
            ),
            child: const Text('Manage Pest'),
          ),
          const SizedBox(width: 16),
          ElevatedButton(
            onPressed: () => Navigator.push(
              context,
              MaterialPageRoute(builder: (context) => const DiseaseManagementPage()),
            ),
            style: ElevatedButton.styleFrom(
              backgroundColor: const Color.fromARGB(255, 3, 39, 4),
              foregroundColor: Colors.white,
            ),
            child: const Text('Manage Disease'),
          ),
        ],
      );
    }

    _showResult(resultMessage, navigationButton);
  }

  void _fallbackAnalyze(List<String> allSelectedSymptoms) {
    int pestCount = 0;
    int diseaseCount = 0;
    int totalSelected = allSelectedSymptoms.length;

    final symptomsForCrop = cropSymptoms[selectedCrop] ?? cropSymptoms['Other']!;
    symptomsForCrop.forEach((section, categories) {
      List<String> allSymptoms = [...categories['Pests']!, ...categories['Diseases']!];
      for (int i = 0; i < allSymptoms.length; i++) {
        if (selectedSymptoms[section]![i]) {
          if (i < categories['Pests']!.length) {
            pestCount++;
          } else {
            diseaseCount++;
          }
        }
      }
    });

    String resultMessage;
    Widget navigationButton;

    if (totalSelected == 0) {
      resultMessage = 'Please select at least one symptom to analyze.';
      navigationButton = const SizedBox.shrink();
    } else {
      double pestPercentage = (pestCount / totalSelected) * 100;
      double diseasePercentage = (diseaseCount / totalSelected) * 100;

      if (pestPercentage >= 60) {
        resultMessage = 'After analysis, the crop is likely pest-affected.';
        navigationButton = ElevatedButton(
          onPressed: () => Navigator.push(
            context,
            MaterialPageRoute(builder: (context) => const PestManagementPage()),
          ),
          style: ElevatedButton.styleFrom(
            backgroundColor: const Color.fromARGB(255, 3, 39, 4),
            foregroundColor: Colors.white,
          ),
          child: const Text('Manage Pest'),
        );
      } else if (diseasePercentage >= 60) {
        resultMessage = 'After analysis, the crop is likely disease-affected.';
        navigationButton = ElevatedButton(
          onPressed: () => Navigator.push(
            context,
            MaterialPageRoute(builder: (context) => const DiseaseManagementPage()),
          ),
          style: ElevatedButton.styleFrom(
            backgroundColor: const Color.fromARGB(255, 3, 39, 4),
            foregroundColor: Colors.white,
          ),
          child: const Text('Manage Disease'),
        );
      } else {
        resultMessage = 'The symptoms suggest it could be either a pest or disease.';
        navigationButton = Row(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            ElevatedButton(
              onPressed: () => Navigator.push(
                context,
                MaterialPageRoute(builder: (context) => const PestManagementPage()),
              ),
              style: ElevatedButton.styleFrom(
                backgroundColor: const Color.fromARGB(255, 3, 39, 4),
                foregroundColor: Colors.white,
              ),
              child: const Text('Manage Pest'),
            ),
            const SizedBox(width: 16),
            ElevatedButton(
              onPressed: () => Navigator.push(
                context,
                MaterialPageRoute(builder: (context) => const DiseaseManagementPage()),
              ),
              style: ElevatedButton.styleFrom(
                backgroundColor: const Color.fromARGB(255, 3, 39, 4),
                foregroundColor: Colors.white,
              ),
              child: const Text('Manage Disease'),
            ),
          ],
        );
      }
    }

    _showResult(resultMessage, navigationButton);
  }

  void _showResult(String message, Widget button) {
    setState(() => _isLoading = false);
    if (mounted) {
      showDialog(
        context: context,
        builder: (context) => AlertDialog(
          title: const Text('Analysis Result'),
          content: Text(message),
          actions: [
            button,
            TextButton(
              onPressed: () => Navigator.pop(context),
              child: const Text('Close'),
            ),
          ],
        ),
      );
    }
  }

