                  _buildSection('Fruits/Grains'),
                  const SizedBox(height: 24),
                  Center(
                    child: ElevatedButton(
                      onPressed: _isLoading ? null : _analyzeSymptoms,
                      style: ElevatedButton.styleFrom(
