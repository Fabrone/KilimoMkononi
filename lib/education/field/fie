  Widget _buildNutrientInput({
    required TextEditingController controller,
    required String label,
    required String unit,
    required String nutrient,
    required IconData icon,
    required Color color,
  }) {
    final ranges = _selectedCrop != null && _selectedStage != null ? getOptimalRanges(_selectedCrop!, _selectedStage!) : null;

    final optimalValue = ranges?[nutrient]?['optimal'];
    final minValue = ranges?[nutrient]?['min'];
    final maxValue = ranges?[nutrient]?['max'];

    return TextFormField(
      controller: controller,
      decoration: InputDecoration(
        labelText: '$label ${unit.isNotEmpty ? "($unit)" : ""}',
        hintText: optimalValue != null ? 'Optimal: $optimalValue' : 'Enter value',
        helperText: ranges == null
            ? 'No range data available for this crop/stage'
            : minValue != null && maxValue != null
                ? 'Range: $minValue – $maxValue $unit'
                : null,
        prefixIcon: Icon(icon, color: color),
        border: const OutlineInputBorder(),
        focusedBorder: OutlineInputBorder(borderSide: BorderSide(color: color, width: 2)),
      ),
      keyboardType: const TextInputType.numberWithOptions(decimal: true),
      validator: (value) {
        if (value == null || value.isEmpty) return 'Required';
        final num = double.tryParse(value);
        if (num == null || num < 0) return 'Enter a valid number ≥ 0';
        return null;
      },
    );
  }

  Future<void> _submitSoilTest() async {
    if (_selectedCrop == null || _selectedStage == null) {
      ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('Please select crop and stage first')));
      return;
    }

    if (!_formKey.currentState!.validate()) return;

    final nitrogen = double.tryParse(_nitrogenCtrl.text.trim()) ?? 0;
    final phosphorus = double.tryParse(_phosphorusCtrl.text.trim()) ?? 0;
    final potassium = double.tryParse(_potassiumCtrl.text.trim()) ?? 0;
    final pH = double.tryParse(_pHCtrl.text.trim()) ?? 0;
    final organicMatter = double.tryParse(_organicMatterCtrl.text.trim()) ?? 0;

    if (nitrogen <= 0 || phosphorus <= 0 || potassium <= 0 || pH <= 0) {
      ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('Please enter valid N, P, K, and pH values')));
      return;
    }

    if (isStudent && _soilTestStudentNameCtrl.text.trim().isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('Please enter your name')));
      return;
    }

    setState(() => _isSaving = true);

    try {
      final nStatus = analyzeNutrientStatus(nitrogen, 'nitrogen', _selectedCrop!, _selectedStage!);
      final pStatus = analyzeNutrientStatus(phosphorus, 'phosphorus', _selectedCrop!, _selectedStage!);
      final kStatus = analyzeNutrientStatus(potassium, 'potassium', _selectedCrop!, _selectedStage!);

      final ranges = getOptimalRanges(_selectedCrop!, _selectedStage!)!;
      final pHMin = ranges['pH']!['min'] as double;
      final pHMax = ranges['pH']!['max'] as double;
      String pHStatus = 'optimal';
      if (pH < pHMin) pHStatus = 'low';
      if (pH > pHMax) pHStatus = 'high';

      final omStatus = organicMatter > 0
          ? analyzeNutrientStatus(organicMatter, 'organicMatter', _selectedCrop!, _selectedStage!)
          : 'unknown';

      List<String> deficiencies = [];
      if (nStatus == 'deficient' || nStatus == 'low') deficiencies.add('nitrogen');
      if (pStatus == 'deficient' || pStatus == 'low') deficiencies.add('phosphorus');
      if (kStatus == 'deficient' || kStatus == 'low') deficiencies.add('potassium');
      if (pHStatus == 'low' || pHStatus == 'high') deficiencies.add('pH');
      if (omStatus == 'deficient' || omStatus == 'low') deficiencies.add('organicMatter');

      await _soilTestResultsCollection?.add({
        'crop': _selectedCrop,
        'stage': _selectedStage,
        'testDate': Timestamp.now(),
        'fieldLocation': _fieldLocationCtrl.text.trim(),
        'submittedBy': isStudent ? 'student' : 'teacher',
        'studentName': isStudent ? _soilTestStudentNameCtrl.text.trim() : null,
        'schoolName': widget.schoolName,
        'className': widget.classId,
        'nitrogen': {'value': nitrogen, 'unit': 'ppm', 'status': nStatus},
        'phosphorus': {'value': phosphorus, 'unit': 'ppm', 'status': pStatus},
        'potassium': {'value': potassium, 'unit': 'ppm', 'status': kStatus},
        'pH': {'value': pH, 'status': pHStatus},
        'organicMatter': {'value': organicMatter, 'unit': '%', 'status': omStatus},
        'deficiencies': deficiencies,
        'reviewStatus': 'pending',
        'reviewUnlocked': false,
        'recommendationsUnlocked': false,
        'submittedAt': FieldValue.serverTimestamp(),
      });

      _resetForm();

      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('✅ Soil test submitted!'), backgroundColor: Colors.green),
      );
    } catch (e) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text('Error: $e'), backgroundColor: Colors.red));
    } finally {
      if (mounted) setState(() => _isSaving = false);
    }
  }

