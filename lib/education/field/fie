  Widget _buildNutrientStatus(String label, Map<String, dynamic> data) {
    final value = data['value'] as num?;
    final status = data['status'] as String? ?? 'unknown';

    late Color statusColor;
    late IconData statusIcon;
    late String statusText;

    switch (status) {
      case 'optimal':
        statusColor = Colors.green;
        statusIcon = Icons.check_circle;
        statusText = 'Optimal';
        break;
      case 'low':
        statusColor = Colors.orange;
        statusIcon = Icons.warning;
        statusText = 'Low';
        break;
      case 'deficient':
        statusColor = Colors.red;
        statusIcon = Icons.error;
        statusText = 'Deficient';
        break;
      case 'high':
        statusColor = Colors.blue;
        statusIcon = Icons.arrow_upward;
        statusText = 'High';
        break;
      default:
        statusColor = Colors.grey;
        statusIcon = Icons.help;
        statusText = 'Unknown';
    }

    return Container(
      margin: const EdgeInsets.only(bottom: 8),
      padding: const EdgeInsets.all(12),
      decoration: BoxDecoration(
        color: statusColor.withOpacity(0.1),
        borderRadius: BorderRadius.circular(8),
        border: Border.all(color: statusColor.withOpacity(0.3)),
      ),
      child: Row(
        children: [
          Icon(statusIcon, color: statusColor, size: 20),
          const SizedBox(width: 12),
          Expanded(child: Text(label, style: const TextStyle(fontWeight: FontWeight.w500))),
          Text(value?.toStringAsFixed(1) ?? '?', style: const TextStyle(fontWeight: FontWeight.bold)),
          const SizedBox(width: 8),
          Container(
            padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
            decoration: BoxDecoration(color: statusColor, borderRadius: BorderRadius.circular(12)),
            child: Text(statusText, style: const TextStyle(color: Colors.white, fontSize: 12, fontWeight: FontWeight.bold)),
          ),
        ],
      ),
    );
  }

