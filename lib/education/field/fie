  Future<void> _submitFieldIssue() async {
    if (!_formKey.currentState!.validate()) return;
    setState(() => _isSaving = true);

    try {
      await _fieldSubmissionsCollection?.add({
        'crop': _selectedCrop,
        'stage': _selectedStage,
        'issue': _selectedIssue,
        'studentObservation': _observationsCtrl.text.trim(),
        'studentIdea': _studentIdeaCtrl.text.trim(),
        'studentName': _studentNameCtrl.text.trim(),
        'schoolName': widget.schoolName,
        'className': widget.classId,
        'reviewStatus': 'pending',
        'hintsUnlocked': false,
        'submittedAt': FieldValue.serverTimestamp(),
      });

      _resetForm();

      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('✅ Submission sent! Wait for teacher review.'), backgroundColor: Colors.green),
      );
    } catch (e) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('Error: $e'), backgroundColor: Colors.red),
      );
    } finally {
      if (mounted) setState(() => _isSaving = false);
    }
  }

  Widget _buildTeacherHintsPreview() {
    final key = '${_selectedCrop}_${_selectedStage}_${_selectedIssue}';
    final hints = fieldManagementTips[key];

    if (hints == null) {
      return const Text('No expert hints available for this combination.');
    }

    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        _buildHintSection('🧪 Chemical Control', hints['chemicalControl']),
        const Divider(height: 24),
        _buildHintSection('🌿 Organic Control', hints['organicControl']),
        const Divider(height: 24),
        _buildHintSection('🌾 Cultural Control', hints['culturalControl']),
      ],
    );
  }

  Widget _buildHintSection(String title, List<dynamic>? items) {
    if (items == null || items.isEmpty) return const SizedBox.shrink();
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Text(title, style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 16)),
        const SizedBox(height: 8),
        ...items.map((item) => Padding(
              padding: const EdgeInsets.only(bottom: 6),
              child: Text('• $item', style: const TextStyle(fontSize: 13)),
            )),
      ],
    );
  }

  Widget _buildStudentSubmissions() {
    return StreamBuilder<QuerySnapshot>(
      stream: _fieldSubmissionsCollection
          ?.where('studentName', isEqualTo: _studentNameCtrl.text.trim())
          ?.where('crop', isEqualTo: _selectedCrop)
          ?.where('stage', isEqualTo: _selectedStage)
          ?.orderBy('submittedAt', descending: true)
          ?.limit(5)
          ?.snapshots(),
      builder: (context, snapshot) {
        if (snapshot.connectionState == ConnectionState.waiting) {
          return const Center(child: CircularProgressIndicator());
        }
        if (!snapshot.hasData || snapshot.data!.docs.isEmpty) {
          return Container(
            padding: const EdgeInsets.all(16),
            decoration: BoxDecoration(color: Colors.grey.shade100, borderRadius: BorderRadius.circular(8)),
            child: const Text('No submissions yet for this crop and stage'),
          );
        }

        final submissions = snapshot.data!.docs;

        return Column(
          children: submissions.map((doc) {
            final data = doc.data() as Map<String, dynamic>;
            return _buildStudentSubmissionCard(data);
          }).toList(),
        );
      },
    );
  }

  Widget _buildStudentSubmissionCard(Map<String, dynamic> data) {
    final isReviewed = data['reviewStatus'] == 'reviewed';
    final hintsUnlocked = data['hintsUnlocked'] == true;

    return Card(
      margin: const EdgeInsets.only(bottom: 12),
      child: Padding(
        padding: const EdgeInsets.all(16),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Row(
              children: [
                Icon(isReviewed ? Icons.check_circle : Icons.pending, color: isReviewed ? Colors.green : Colors.orange),
                const SizedBox(width: 8),
                Expanded(
                  child: Text(
                    '${data['crop']} - ${data['issue']}',
                    style: const TextStyle(fontWeight: FontWeight.bold),
                  ),
                ),
                if (isReviewed)
                  Container(
                    padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
                    decoration: BoxDecoration(
                      color: _getGradeColor(data['teacherGrade']),
                      borderRadius: BorderRadius.circular(12),
                    ),
                    child: Text(
                      _getGradeLabel(data['teacherGrade']),
                      style: const TextStyle(color: Colors.white, fontSize: 12),
                    ),
                  ),
              ],
            ),
            const SizedBox(height: 8),
            Text('Your idea: ${data['studentIdea'] ?? '—'}', style: const TextStyle(fontSize: 13)),
            if (isReviewed && data['teacherComment'] != null) ...[
              const SizedBox(height: 8),
              Container(
                padding: const EdgeInsets.all(8),
                decoration: BoxDecoration(color: Colors.blue.shade50, borderRadius: BorderRadius.circular(4)),
                child: Text(
                  'Teacher: ${data['teacherComment']}',
                  style: TextStyle(fontSize: 12, color: Colors.blue.shade900),
                ),
              ),
            ],
            if (hintsUnlocked) ...[
              const SizedBox(height: 12),
              ElevatedButton.icon(
                onPressed: () => _showHintsDialog(data),
                icon: const Icon(Icons.lightbulb, size: 16),
                label: const Text('View Expert Hints', style: TextStyle(fontSize: 12)),
                style: ElevatedButton.styleFrom(
                  backgroundColor: Colors.green,
                  padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
                ),
              ),
            ],
          ],
        ),
      ),
    );
  }

  void _showHintsDialog(Map<String, dynamic> data) {
    final key = '${data['crop']}_${data['stage']}_${data['issue']}';
    final hints = fieldManagementTips[key];

    if (hints == null || (hints['chemicalControl']?.isEmpty ?? true) && (hints['organicControl']?.isEmpty ?? true) && (hints['culturalControl']?.isEmpty ?? true)) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('No hints available for this issue')),
      );
      return;
    }

    showDialog(
      context: context,
      builder: (context) => AlertDialog(
        title: const Text('💡 Expert Management Hints'),
        content: SingleChildScrollView(
          child: Column(
            mainAxisSize: MainAxisSize.min,
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              _buildHintSection('🧪 Chemical Control', hints['chemicalControl']),
              const Divider(height: 24),
              _buildHintSection('🌿 Organic Control', hints['organicControl']),
              const Divider(height: 24),
              _buildHintSection('🌾 Cultural Control', hints['culturalControl']),
            ],
          ),
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context),
            child: const Text('Close'),
          ),
        ],
      ),
    );
  }

