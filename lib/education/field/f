  Future<void> _submitFieldIssue() async {
    if (!_formKey.currentState!.validate()) return;

    setState(() => _isSaving = true);

    try {
      await _fieldSubmissionsCollection?.add({
        'crop': _selectedCrop,
        'stage': _selectedStage,
        'issue': _selectedIssue,
        'studentObservation': _observationsCtrl.text.trim(),
        'studentIdea': _studentIdeaCtrl.text.trim(),
        'studentName': isStudent ? _studentNameCtrl.text.trim() : 'Teacher Observation',
        'submittedBy': isStudent ? 'student' : 'teacher',
        'schoolName': widget.schoolName,
        'className': widget.classId,
        'reviewStatus': 'pending',
        'submittedAt': FieldValue.serverTimestamp(),
      });

      _resetForm();

      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('✅ Submission sent! Wait for teacher review.'),
          backgroundColor: Colors.green,
        ),
      );
    } catch (e) {
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('Error: $e'), backgroundColor: Colors.red),
      );
    } finally {
      setState(() => _isSaving = false);
    }
  }

  //Student submissions query with conversation support
  Widget _buildStudentSubmissions() {
    final studentName = _studentNameCtrl.text.trim();

    if (studentName.isEmpty) {
      return Container(
        padding: const EdgeInsets.all(16),
        decoration: BoxDecoration(
          color: Colors.orange.shade50,
          borderRadius: BorderRadius.circular(8),
        ),
        child: const Text('👆 Enter your name above to see your submissions'),
      );
    }

    return StreamBuilder<QuerySnapshot>(
      stream: _fieldSubmissionsCollection
          ?.where('submittedBy', isEqualTo: 'student')
          ?.orderBy('submittedAt', descending: true)
          ?.limit(100)
          ?.snapshots(),
      builder: (context, snapshot) {
        if (snapshot.connectionState == ConnectionState.waiting) {
          return const Center(child: CircularProgressIndicator());
        }

        if (!snapshot.hasData || snapshot.data == null) {
          return const Text('No data available');
        }

        final mySubmissions = snapshot.data!.docs.where((doc) {
          final data = doc.data() as Map<String, dynamic>;
          return data['studentName']?.toString().trim() == studentName;
        }).toList();

        if (mySubmissions.isEmpty) {
          return Container(
            padding: const EdgeInsets.all(16),
            decoration: BoxDecoration(
              color: Colors.blue.shade50,
              borderRadius: BorderRadius.circular(8),
            ),
            child: Column(
              children: [
                const Icon(Icons.inbox_outlined, size: 48, color: Colors.grey),
                const SizedBox(height: 8),
                const Text('No submissions yet'),
                const SizedBox(height: 4),
                Text(
                  'Looking for: "$studentName"',
                  style: const TextStyle(fontSize: 11, color: Colors.grey),
                ),
              ],
            ),
          );
        }

        return Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Container(
              padding: const EdgeInsets.all(8),
              margin: const EdgeInsets.only(bottom: 12),
              decoration: BoxDecoration(
                color: Colors.green.shade50,
                borderRadius: BorderRadius.circular(4),
              ),
              child: Text(
                '${mySubmissions.length} submission${mySubmissions.length == 1 ? '' : 's'} found',
                style: TextStyle(
                  fontSize: 12,
                  color: Colors.green.shade900,
                  fontWeight: FontWeight.bold,
                ),
              ),
            ),
            ...mySubmissions.map((doc) {
              final data = doc.data() as Map<String, dynamic>;
              data['docId'] = doc.id; // ← Pass docId for reply feature
              return _buildStudentSubmissionCard(data);
            }),
          ],
        );
      },
    );
  }

