  Future<void> _submitSoilTest() async {
    if (_soilTestSelectedCrop == null || _soilTestSelectedStage == null) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Please select crop and stage')),
      );
      return;
    }

    setState(() => _isSaving = true);

    try {
      final nValue = double.tryParse(_nitrogenCtrl.text) ?? 0;
      final pValue = double.tryParse(_phosphorusCtrl.text) ?? 0;
      final kValue = double.tryParse(_potassiumCtrl.text) ?? 0;
      final phValue = double.tryParse(_pHCtrl.text) ?? 7.0;
      final omValue = double.tryParse(_organicMatterCtrl.text) ?? 0;

      final nStatus = _getNutrientStatus('N', nValue);
      final pStatus = _getNutrientStatus('P', pValue);
      final kStatus = _getNutrientStatus('K', kValue);
      final phStatus = _getpHStatus(phValue);
      final omStatus = _getOMStatus(omValue);

      final deficiencies = <String>[];
      if (nStatus == 'Low' || nStatus == 'Deficient') deficiencies.add('Nitrogen');
      if (pStatus == 'Low' || pStatus == 'Deficient') deficiencies.add('Phosphorus');
      if (kStatus == 'Low' || kStatus == 'Deficient') deficiencies.add('Potassium');

      await _soilTestResultsCollection?.add({
        'crop': _soilTestSelectedCrop,
        'stage': _soilTestSelectedStage,
        'testDate': Timestamp.fromDate(_soilTestDate),
        'fieldLocation': _soilTestFieldLocationCtrl.text.trim(),
        'submittedBy': isStudent ? 'student' : 'teacher',
        'studentName': isStudent ? _soilTestStudentNameCtrl.text.trim() : 'Teacher Test',
        'schoolName': widget.schoolName,
        'className': widget.classId,
        'nitrogen': {'value': nValue, 'unit': _nitrogenUnit, 'status': nStatus},
        'phosphorus': {'value': pValue, 'unit': _phosphorusUnit, 'status': pStatus},
        'potassium': {'value': kValue, 'unit': _potassiumUnit, 'status': kStatus},
        'pH': {'value': phValue, 'status': phStatus},
        'organicMatter': {'value': omValue, 'unit': _organicMatterUnit, 'status': omStatus},
        'deficiencies': deficiencies,
        'reviewStatus': 'pending',
        'submittedAt': FieldValue.serverTimestamp(),
      });

      _nitrogenCtrl.clear();
      _phosphorusCtrl.clear();
      _potassiumCtrl.clear();
      _pHCtrl.clear();
      _organicMatterCtrl.clear();
      _soilTestFieldLocationCtrl.clear();

      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('✅ Soil test submitted!'), backgroundColor: Colors.green),
      );
    } catch (e) {
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('Error: $e'), backgroundColor: Colors.red),
      );
    } finally {
      setState(() => _isSaving = false);
    }
  }

  String _getNutrientStatus(String nutrient, double value) {
    if (nutrient == 'N') {
      if (value < 20) return 'Deficient';
      if (value < 40) return 'Low';
      if (value <= 80) return 'Optimal';
      if (value <= 120) return 'High';
      return 'Excess';
    } else if (nutrient == 'P') {
      if (value < 10) return 'Deficient';
      if (value < 25) return 'Low';
      if (value <= 50) return 'Optimal';
      if (value <= 80) return 'High';
      return 'Excess';
    } else if (nutrient == 'K') {
      if (value < 80) return 'Deficient';
      if (value < 150) return 'Low';
      if (value <= 300) return 'Optimal';
      if (value <= 500) return 'High';
      return 'Excess';
    }
    return 'Unknown';
  }

  String _getpHStatus(double value) {
    if (value < 5.5) return 'Too Acidic';
    if (value < 6.0) return 'Slightly Acidic';
    if (value <= 7.0) return 'Optimal';
    if (value <= 7.5) return 'Slightly Alkaline';
    return 'Too Alkaline';
  }

  String _getOMStatus(double value) {
    if (value < 2) return 'Low';
    if (value <= 5) return 'Moderate';
    return 'High';
  }

