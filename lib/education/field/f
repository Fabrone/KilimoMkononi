  Future<void> _initializeFirestore() async {
    final user = FirebaseAuth.instance.currentUser;
    if (user != null) {
      setState(() {
        _currentUserId = user.uid;
      });
    }

    final pathParts = widget.classId.split('_');
    if (pathParts.length >= 3) {
      final schoolName = pathParts[0];
      final system = pathParts[1];
      final gradeId = pathParts.sublist(2).join('_');

      final classDocRef = FirebaseFirestore.instance
          .collection('schools')
          .doc(schoolName)
          .collection('systems')
          .doc(system)
          .collection('grades')
          .doc(gradeId);

      setState(() {
        _fieldSubmissionsCollection = classDocRef.collection('field_submissions');
        _soilTestResultsCollection = classDocRef.collection('soil_test_results');
      });
    }
  }

  @override
  void dispose() {
    _tabController.dispose();
    _observationsCtrl.dispose();
    _studentIdeaCtrl.dispose();
    _studentNameCtrl.dispose();
    _soilTestStudentNameCtrl.dispose();
    _soilTestFieldLocationCtrl.dispose();
    _nitrogenCtrl.dispose();
    _phosphorusCtrl.dispose();
    _potassiumCtrl.dispose();
    _pHCtrl.dispose();
    _organicMatterCtrl.dispose();
    super.dispose();
  }

