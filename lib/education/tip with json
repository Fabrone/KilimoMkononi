const Color primaryGreen = Color(0xFF032704);

extension StringExt on String {
  String capitalize() => isNotEmpty ? '${this[0].toUpperCase()}${substring(1)}' : this;
}

extension TextEditingControllerExt on TextEditingController {
  String get safeText => text.trim();
}

class EducationFarmingTips extends StatefulWidget {
  final EduRole role;
  final String schoolName;
  final String classId;

  const EducationFarmingTips({
    super.key,
    required this.role,
    required this.schoolName,
    required this.classId,
  });

  @override
  State<EducationFarmingTips> createState() => _EducationFarmingTipsState();
}

class _EducationFarmingTipsState extends State<EducationFarmingTips> {
  String? _selectedCrop;
  String _cropTip = '';
  late String _schoolId;
  late String _gradeId;
  final String _contentType = 'farming_content';

  /// NEW: Holds all JSON farming tips
  Map<String, dynamic> _jsonTips = {};

  @override
  void initState() {
    super.initState();

    // existing code untouched
    final match = RegExp(r'^(.*)_(\d+)$').firstMatch(widget.classId);
    if (match == null) return;
    _schoolId = match.group(1)!;
    _gradeId = match.group(2)!;
    classIdNotifier.value = widget.classId;

    // NEW: Load the farming tips JSON
    _loadFarmingTips();
  }

  /// NEW: load the JSON file from assets
  Future<void> _loadFarmingTips() async {
    final jsonString = await rootBundle.loadString('assets/farming_tips/farming_tips.json');
    final data = jsonDecode(jsonString);

    setState(() {
      _jsonTips = data["farming_tips"] ?? {};
    });
  }

  // ===========================================================
  // ============= QUIZ & SIMULATION CODE (UNCHANGED) ==========
  // ===========================================================

  void _showQuizBuilder() => showDialog(
        context: context,
        builder: (_) => FarmingQuizBuilder(onSave: (d) => _save('quiz', d)),
      );

  void _showSimBuilder() => showDialog(
        context: context,
        builder: (_) => FarmingSimulationBuilder(onSave: (d) => _save('simulation', d)),
      );

  Future<void> _save(String type, Map<String, dynamic> data) async {
    final String title = data['title'] as String? ?? '${type.capitalize()} Content';
    final dynamic content = type == 'quiz' ? data['questions'] : data['steps'];

    await FirebaseFirestore.instance
        .collection('schools')
        .doc(_schoolId)
        .collection('grades')
        .doc(_gradeId)
        .collection(_contentType)
        .add({
      'type': type,
      'title': title,
      'data': jsonEncode(content),
      'createdAt': FieldValue.serverTimestamp(),
      'userId': FirebaseAuth.instance.currentUser!.uid,
      'schoolId': _schoolId,
      'gradeId': _gradeId,
    });

    if (mounted) {
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('$title saved!'), backgroundColor: Colors.green),
      );
    }
  }

  Future<void> _launch(
      String type, Widget Function(Map<String, dynamic>) builder) async {
    try {
      final snap = await FirebaseFirestore.instance
          .collection('schools')
          .doc(_schoolId)
          .collection('grades')
          .doc(_gradeId)
          .collection(_contentType)
          .where('type', isEqualTo: type)
          .orderBy('createdAt', descending: true)
          .limit(1)
          .get();

      if (snap.docs.isEmpty || !mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(
              content:
                  Text('No content yet! Ask your teacher to create one.')),
        );
        return;
      }

      final doc = snap.docs.first;
      final data = doc.data();
      final title = (data['title'] as String?)?.trim().isNotEmpty == true
          ? data['title']
          : '${type.capitalize()} Content';
      final payload =
          data['data'] is String ? jsonDecode(data['data']) : data['data'];

      final Map<String, dynamic> fullPayload = {
        'id': doc.id,
        'title': title,
        if (type == 'quiz') 'questions': payload else 'steps': payload,
      };

      if (mounted) {
        Navigator.push(
            context, MaterialPageRoute(builder: (_) => builder(fullPayload)));
      }
    } catch (e) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
            SnackBar(content: Text('Error: $e')));
      }
    }
  }

  Future<void> _takeQuiz() =>
      _launch('quiz', (p) => FarmingQuizScreen(payload: p));
  Future<void> _takeSim() =>
      _launch('simulation', (p) => FarmingSimulationScreen(payload: p));

  // ===========================================================
  // ==================== UI SECTION ===========================
  // ===========================================================

  @override
  Widget build(BuildContext context) {
    final crops = _jsonTips.keys.toList();

    return Scaffold(
      appBar: AppBar(
        title: const Text('Farming Tips'),
        backgroundColor: primaryGreen,
        foregroundColor: Colors.white,
      ),
      body: SingleChildScrollView(
        padding: const EdgeInsets.all(16),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            DropdownButtonFormField<String>(
              value: _selectedCrop,
              hint: const Text('Select Crop'),
              decoration: const InputDecoration(
                labelText: 'Crop',
                border: OutlineInputBorder(),
                prefixIcon: Icon(Icons.agriculture),
              ),
              items: crops
                  .map((crop) => DropdownMenuItem(
                        value: crop,
                        child: Text(crop),
                      ))
                  .toList(),
              onChanged: (v) {
                setState(() {
                  _selectedCrop = v;
                  _cropTip = v != null ? _jsonTips[v] : '';
                });
              },
            ),
            const SizedBox(height: 24),

            if (_cropTip.isNotEmpty)
              Card(
                elevation: 4,
                child: Padding(
                  padding: const EdgeInsets.all(16),
                  child: MarkdownBody(data: _cropTip),
                ),
              ),

            const SizedBox(height: 40),
          ],
        ),
      ),
      bottomNavigationBar: Padding(
        padding: const EdgeInsets.all(16),
        child: Row(
          children: widget.role == EduRole.teacher
              ? [
                  Expanded(
                    child: ElevatedButton.icon(
                      onPressed: _showQuizBuilder,
                      icon: const Icon(Icons.quiz),
                      label: const Text('Create Quiz'),
                      style: ElevatedButton.styleFrom(
                          backgroundColor: primaryGreen),
                    ),
                  ),
                  const SizedBox(width: 12),
                  Expanded(
                    child: ElevatedButton.icon(
                      onPressed: _showSimBuilder,
                      icon: const Icon(Icons.play_circle),
                      label: const Text('Create Simulation'),
                      style: ElevatedButton.styleFrom(
                          backgroundColor: primaryGreen),
                    ),
                  ),
                ]
              : [
                  Expanded(
                    child: ElevatedButton.icon(
                      onPressed: _takeQuiz,
                      icon: const Icon(Icons.quiz),
                      label: const Text('Take Quiz'),
                      style: ElevatedButton.styleFrom(
                          backgroundColor: primaryGreen),
                    ),
                  ),
                  const SizedBox(width: 12),
                  Expanded(
                    child: ElevatedButton.icon(
                      onPressed: _takeSim,
                      icon: const Icon(Icons.play_circle),
                      label: const Text('Run Simulation'),
                      style: ElevatedButton.styleFrom(
                          backgroundColor: primaryGreen),
                    ),
                  ),
                ],
        ),
      ),
    );
  }
}

